# Copy this file to .env or your local environment manager. Never commit real values.

# PostgreSQL (local development example)
DATABASE_URL=jdbc:postgresql://localhost:5432/turant
DATABASE_USERNAME=turant
DATABASE_PASSWORD=change-me

# Supabase (optional future integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (future payment integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (future notification integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Object storage (choose/configure a provider before enabling uploads)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
